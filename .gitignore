# Python bytecode and local environments
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Test, coverage and static-analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Packaging outputs (build and installation artifacts belong outside this checkout)
/build/
/dist/
/artifacts/
/*.zip
*.egg-info/
.eggs/

# Local investigation files (keep these outside the checkout, even when ignored)
/research/
/work-notes/
/tmp/
*.log

# Local secrets; retain templates that document configuration
.env
.env.*
!.env.example
!.env.sample

# OS metadata and editor temporary files
.DS_Store
._*
Thumbs.db
.idea/
*.swp
*.swo
*~
