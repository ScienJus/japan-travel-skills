#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -n "${POCKET_CONCIERGE_PYTHON:-}" ]; then
  PYTHON=$POCKET_CONCIERGE_PYTHON
elif [ -x "$ROOT/.venv/bin/python" ]; then
  PYTHON=$ROOT/.venv/bin/python
else
  PYTHON=python3
fi
exec "$PYTHON" "$ROOT/skills/pocket-concierge/scripts/pocket_concierge.py" "$@"
